# ─── Pandora — Environment Variables ───
# Copy this file to .env.local and fill in values as needed.
# The platform works without most keys — data sources with missing keys are gracefully skipped.

# ── Data Source API Keys (optional) ──
# FIRMS_API_KEY=                        # NASA FIRMS fire data (https://firms.modaps.eosdis.nasa.gov/api/area/)
# AIS_API_KEY=                          # Maritime vessel tracking (aisstream.io)
# OPENSKY_CLIENT_ID=                    # OpenSky OAuth2 — higher rate limits
# OPENSKY_CLIENT_SECRET=                # OpenSky OAuth2

# ── Scanner Backend (required for RECON features) ──
# SCANNER_URL=http://your-scanner:7700  # Pandora scanner backend URL
# SCANNER_KEY=                          # Scanner authentication key (must match backend Pandora_KEY)

# ── Local AI / Ollama (optional, used by Pandora AIP) ──
# OLLAMA_BASE_URL=http://localhost:11434 # Local Ollama server
# OLLAMA_MODEL=llama3.1:8b               # Example: llama3.1:8b, mistral, qwen2.5:7b

# ── Docker / runtime ──
# PANDORA_PORT=3001                     # Host web UI port (container stays on 3000)

# ── CyberDef Service (new) ──
# PANDORA_CYBERDEF_PORT=7711
# PANDORA_CYBERDEF_AI_ENABLED=true
# ABUSEIPDB_API_KEY=                    # AbuseIPDB API key for IP reputation
# URLSCAN_API_KEY=                      # URLScan.io API key for domain scanning

# ── Aerospace Service (new) ──
# PANDORA_AEROSPACE_PORT=7713
# PANDORA_AEROSPACE_AI_ENABLED=true

# ── Governance Service — ABAC + tamper-evident audit journal ──
# Enforced by src/proxy.ts: a classified resource is served only on an explicit allow
# decision, and every decision is journalised in a hash-chained audit log.
PANDORA_GOVERNANCE_PORT=7715
# PANDORA_GOVERNANCE_URL=http://pandora-governance:7715
# PANDORA_GOVERNANCE_DB=/data/governance.db
# Leave PANDORA_GOVERNANCE_URL empty to disable enforcement entirely (reported as
# "unconfigured" on /sovereignty and in the X-Pandora-Governance response header).

# ── Cases Service — persistent analyst cases ──
# PANDORA_CASES_PORT=7705
# PANDORA_CASES_DB=/data/cases.db

# ── Knowledge graph (ontology service fan-out) ──
# PANDORA_GRAPH_TIMEOUT=14              # Per-source timeout when fusing the graph
# PANDORA_GRAPH_CACHE_TTL=60            # Seconds the fused graph is cached
# PANDORA_GRAPH_MAX_AIRCRAFT=120        # Aircraft entities kept per graph build
# PANDORA_GRAPH_NEAR_KM=100             # OBSERVED_NEAR radius (haversine)

# ── Deployment profile (shown on /sovereignty) ──
# on-prem | air-gapped | cloud
PANDORA_DEPLOYMENT_PROFILE=on-prem
