# ═══════════════════════════════════════════════════════════════════════════
#  Pandora — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  Pandora works fully WITHOUT any third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  As of this revision the application code only actually reads SCANNER_URL
#  and SCANNER_KEY. The other keys below are OPTIONAL and reserved for higher
#  rate limits / future data sources — set them only if you extend the code or
#  hit rate limits on the public feeds.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND  ── the ONLY keys the current code consumes ──
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate Pandora scanner backend.
#  SCANNER_KEY here MUST equal the backend's Pandora_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  LOCAL AI / OLLAMA  (optional — powers Pandora AIP briefing)
# ─────────────────────────────────────────────────────────────────────────
# Install Ollama locally, pull a model, then point Pandora at it:
#   ollama pull llama3.1:8b
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=llama3.1:8b
# If Ollama is unavailable, Pandora AIP falls back to a deterministic local
# rules-based briefing using the fusion snapshot.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ─────────────────────────────────────────────────────────────────────────
#  PANDORA DIGEST MICROSERVICE  (optional — enabled by docker-compose)
# ─────────────────────────────────────────────────────────────────────────
# FastAPI service that aggregates Pandora feeds and returns /digest JSON.
# In Docker Compose, Pandora calls http://pandora-digest:7702.
PANDORA_DIGEST_URL=http://pandora-digest:7702
PANDORA_DIGEST_PORT=7702

# Internal URL used by the digest service to call Pandora APIs.
PANDORA_BASE_URL=http://pandora:3000


# ─────────────────────────────────────────────────────────────────────────
#  PANDORA ALERTS MICROSERVICE  (optional — enabled by docker-compose)
# ─────────────────────────────────────────────────────────────────────────
# FastAPI service that reads Pandora Digest and emits actionable alerts.
PANDORA_ALERTS_URL=http://pandora-alerts:7703
PANDORA_ALERTS_PORT=7703


# ─────────────────────────────────────────────────────────────────────────
#  PANDORA ONTOLOGY MICROSERVICE  (Palantir-like entity graph)
# ─────────────────────────────────────────────────────────────────────────
# FastAPI service that transforms digest + alerts into entities and relations.
PANDORA_ONTOLOGY_URL=http://pandora-ontology:7704
PANDORA_ONTOLOGY_PORT=7704

# Pandora Palantir-like workflow microservices.
PANDORA_CASES_URL=http://pandora-cases:7705
PANDORA_CASES_PORT=7705
PANDORA_HOTSPOTS_URL=http://pandora-hotspots:7706
PANDORA_HOTSPOTS_PORT=7706
PANDORA_COPILOT_URL=http://pandora-copilot:7707
PANDORA_COPILOT_PORT=7707
PANDORA_RISK_URL=http://pandora-risk:7708
PANDORA_RISK_PORT=7708


# ─────────────────────────────────────────────────────────────────────────
#  OBSERVABILITY — Grafana + Prometheus
# ─────────────────────────────────────────────────────────────────────────
# Grafana UI: http://localhost:3002  (default admin / pandora)
# Prometheus UI: http://localhost:9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pandora
PROMETHEUS_PORT=9090
BLACKBOX_PORT=9115
CADVISOR_PORT=8080


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container listens on 3000).
# Change this if 3001 is already taken on your host.
PANDORA_PORT=3001

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
